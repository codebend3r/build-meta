{
  "name": "build-meta",
  "version": "0.1.0",
  "description": "Writes a meta.json with the package version, build date, environment, git branch, and last commit for the current project",
  "author": "CJ Rivas <cj.rivas.dev@gmail.com>",
  "contributors": [
    "CJ Rivas <cj.rivas.dev@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codebend3r/build-meta.git"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && chmod +x bin/build-meta.js",
    "clean": "rm -rf bin",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "bun run build && bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky && bun run build"
  },
  "files": [
    "bin",
    "CHANGES.md"
  ],
  "bin": {
    "build-meta": "bin/build-meta.js"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@types/node": "26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "9.1.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0"
  }
}
